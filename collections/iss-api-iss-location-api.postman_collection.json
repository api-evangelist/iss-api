          "name": "Get Current ISS Location",
          "request": {
            "name": "Get Current ISS Location",
            "description": {
              "content": "Returns the current latitude and longitude of the International Space Station along with a Unix timestamp indicating when the coordinates were recorded. No parameters are required. The data is refreshed approximately every five seconds as the ISS orbits Earth at roughly 28,000 km/h and at an altitude of approximately 400 km.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "iss-now.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
